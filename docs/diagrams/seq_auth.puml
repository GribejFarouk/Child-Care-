@startuml seq_auth
!theme plain
skinparam backgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 120
skinparam shadowing false

title Sequence - Authentification parent ou medecin

actor "Utilisateur" as User
participant "Frontend React" as UI
participant "Nginx" as Nginx
participant "Auth Service" as Auth
database "auth_db" as DB

User -> UI : Saisit email et mot de passe
UI -> Nginx : POST /api/auth/login/
Nginx -> Auth : Transfert de la requete
Auth -> DB : Chercher utilisateur par email

alt Identifiants invalides
  Auth --> UI : 401 erreur
  UI --> User : Message d'erreur
else Identifiants valides
  Auth -> Auth : Genere access + refresh JWT
  Auth --> UI : 200 {user, tokens}
  UI -> UI : Stocke les tokens
  alt role = parent
    UI --> User : Redirection /dashboard
  else role = doctor
    UI --> User : Redirection /doctor/dashboard
  end
end

@enduml
